# Один ключ на всех: вывод veil keygen. Либо файл со списком, см. VEIL_KEYS.
VEIL_PSK=
# Порт на VPS. Внутри контейнера сервер всегда слушает 443.
VEIL_PORT=443
# Каталог с cert.pem и key.pem. Не нужен, если заданы домен и согласие ниже.
VEIL_CERT_DIR=./certs

# Файл ключей: одна строка — один base64, как у veil keygen. Пустые строки и строки с # пропускаются.
# На хосте каталог VEIL_KEYS_DIR, в контейнере путь VEIL_KEYS.
# VEIL_KEYS_DIR=./keys
# VEIL_KEYS=/etc/veil/keys/keys

# Сертификат Let's Encrypt. Нужны оба значения, иначе контейнер ждёт PEM.
# VEIL_ACME_DOMAIN=example.com
# VEIL_ACME_ACCEPT=1
# Порт HTTP-01 на хосте. В контейнере проверка слушает :80.
# VEIL_ACME_HTTP_PORT=80
